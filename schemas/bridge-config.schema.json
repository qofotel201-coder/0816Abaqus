{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schemas/bridge-config.schema.json",
  "title": "Portable external Python to Abaqus bridge configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abaqus_release",
    "abaqus_command",
    "worker",
    "run_root",
    "allowed_cae_roots",
    "hard_timeout_seconds",
    "keep_staged_cae"
  ],
  "properties": {
    "abaqus_release": {
      "const": "2022"
    },
    "abaqus_command": {
      "$ref": "#/$defs/localPath"
    },
    "worker": {
      "$ref": "#/$defs/localPath"
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/localPath"
        },
        "audit": {
          "$ref": "#/$defs/localPath"
        },
        "workspace": {
          "$ref": "#/$defs/localPath"
        },
        "odb": {
          "$ref": "#/$defs/localPath"
        }
      }
    },
    "run_root": {
      "$ref": "#/$defs/localPath"
    },
    "allowed_cae_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/localPath"
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 900
      }
    },
    "hard_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1024
    },
    "keep_staged_cae": {
      "const": false
    }
  },
  "$defs": {
    "localPath": {
      "type": "string",
      "minLength": 3,
      "not": {
        "pattern": "^(?:\\\\\\\\|//)"
      }
    }
  }
}
