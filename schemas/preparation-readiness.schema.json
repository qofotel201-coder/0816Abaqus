{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schemas/preparation-readiness.schema.json",
  "title": "Machine preparation readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "overall_status",
    "counts",
    "checks",
    "solver_submitted"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall_status": {
      "enum": [
        "READY",
        "NOT_READY"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCKED"
      ],
      "properties": {
        "PASS": {
          "type": "integer",
          "minimum": 0
        },
        "WARN": {
          "type": "integer",
          "minimum": 0
        },
        "FAIL": {
          "type": "integer",
          "minimum": 0
        },
        "BLOCKED": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASS",
              "WARN",
              "FAIL",
              "BLOCKED"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "solver_submitted": {
      "const": false
    }
  }
}
