{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schemas/operation-response.schema.json",
  "title": "Automation response",
  "type": "object",
  "required": [
    "jsonrpc",
    "id"
  ],
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "_bridge": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "required": [
        "result"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ],
  "additionalProperties": false
}
